# Copy to .env.local for development, or use deploy/init-env.sh in production.
# Node.js 24 LTS; no Sites, D1, R2 or ChatGPT credentials are required.
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
ADMIN_ENTRY_PASSWORD=
ADMIN_SESSION_SECRET=

# Development only; never enables HTTP cookies under NODE_ENV=production.
# ALLOW_INSECURE_COOKIES=1

# Production nginx overwrites X-Real-IP; the Node port must be loopback-only.
# TRUST_PROXY=1

# Optional existing PostgreSQL/OSS adapter. Leave empty for SQLite + ECS disk.
# CATALOG_API_URL=
# CATALOG_API_TOKEN=
# ALIYUN_SIGNER_URL=
# ALIYUN_SIGNER_TOKEN=
# MEDIA_ALLOWED_HOSTS=your-oss-bucket.oss-cn-beijing.aliyuncs.com
